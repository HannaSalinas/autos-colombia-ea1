# Credenciales de PostgreSQL para Docker Compose. Antes de levantar el sistema:
#   cp .env.example .env
# y cambia POSTGRES_PASSWORD en .env por una propia. .env NO se sube a git.
# Si cambias la contraseña después de crear la base, recréala: docker compose down -v
POSTGRES_USER=autos
POSTGRES_PASSWORD=cambia_esta_clave

# --- Iteración 2: sesión y cuentas semilla ---
# Clave para firmar los tokens de sesión: al menos 32 caracteres al azar. Para generar una:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRETO=cambia_esta_clave_de_firma_por_una_de_32_o_mas_caracteres
# Cuentas que crean las semillas la primera vez (después no se cambian). Contraseñas de 8 a 64
# caracteres, con al menos una letra y un número. Usuario: 4 a 30 minúsculas, dígitos, . o _
ADMIN_USUARIO=admin
ADMIN_NOMBRE="Sandra Patiño"
ADMIN_CONTRASENA=cambia_esta_clave1
MARTA_CONTRASENA=cambia_esta_clave2
DIEGO_CONTRASENA=cambia_esta_clave3
